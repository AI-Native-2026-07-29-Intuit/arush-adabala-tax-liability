{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsBuildPush",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:AI-Native-2026-07-29-Intuit/arush-adabala-tax-liability:environment:dev",
            "repo:AI-Native-2026-07-29-Intuit/arush-adabala-tax-liability:ref:refs/heads/main"
          ]
        }
      }
    }
  ]
}
