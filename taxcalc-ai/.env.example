# taxcalc-ai/.env.example - placeholder values only. Copy to .env and fill in locally.
# Every variable is read by TaxcalcAiSettings under the TAXCALC_AI_ prefix.
TAXCALC_AI_PROXY_BASE_URL=http://localhost:8080
TAXCALC_AI_PROXY_API_KEY=replace-me-not-a-real-key
TAXCALC_AI_PROXY_TIMEOUT_SECONDS=30.0
TAXCALC_AI_PROXY_MAX_RETRIES=3
TAXCALC_AI_MODEL_ID=claude-haiku-4-5
TAXCALC_AI_TENANT_ID=tenant-a
TAXCALC_AI_LOG_LEVEL=INFO

# ---- W7 D2: data tooling + AI observability ----------------------------------------------
# Placeholders only. A real LangSmith personal-access key carries the SaaS's own prefix and must
# never be committed;
# `.env` is in .gitignore and CI reads these from GitHub Actions secrets instead.
TAXCALC_AI_LANGSMITH_API_KEY=replace-me-not-a-real-langsmith-key
TAXCALC_AI_LANGSMITH_PROJECT=taxcalc-ai-dev
TAXCALC_AI_PG_DSN=postgresql://taxcalc:replace-me@localhost:5432/taxcalc
TAXCALC_AI_ANTHROPIC_API_KEY=replace-me-not-a-real-anthropic-key

# ---- W7 D3: RAG 2.0 production retrieval --------------------------------------------------
# The semantic cache. Same Redis the W3 D1 cost-SLI pattern uses; today's keys are
# taxcalc_ai:sem:{tenant_id}:e{epoch}:{hash} plus one taxcalc_ai:cache-epoch:{tenant_id}
# counter per tenant.
TAXCALC_AI_REDIS_URL=redis://localhost:6379/0
# The corpus file the Airflow ingest DAG reads. Read at task-execution time, not at DAG-parse
# time: the scheduler re-parses the DAG every few seconds and a KeyError at parse time breaks
# the whole DAG bag rather than one run.
TAXCALC_AI_CORPUS_PATH=tests/fixtures/corpus_seed.jsonl

# The four pipeline stage flags. Every one DEFAULTS TO ON when unset - the upgrades are the
# intended configuration, and a misspelled variable must not silently revert the pipeline to
# the W7 D2 baseline. Recognised off values: 0, false, no, off.
#
# They stay live for at least two weeks post-rollout so a real-traffic regression can be
# A/B'd back to the W7 D2 behaviour (all four off) without a deploy.
RAG_USE_HYBRID=true
RAG_USE_MMR=true
RAG_USE_RERANK=true
RAG_USE_FILTER=true
