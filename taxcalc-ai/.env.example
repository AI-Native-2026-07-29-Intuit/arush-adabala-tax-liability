# taxcalc-ai/.env.example - placeholder values only. Copy to .env and fill in locally.
# Every variable is read by TaxcalcAiSettings under the TAXCALC_AI_ prefix.
TAXCALC_AI_PROXY_BASE_URL=http://localhost:8080
TAXCALC_AI_PROXY_API_KEY=replace-me-not-a-real-key
TAXCALC_AI_PROXY_TIMEOUT_SECONDS=30.0
TAXCALC_AI_PROXY_MAX_RETRIES=3
TAXCALC_AI_MODEL_ID=claude-haiku-4-5
TAXCALC_AI_TENANT_ID=tenant-a
TAXCALC_AI_LOG_LEVEL=INFO

# ---- W7 D2: data tooling + AI observability ----------------------------------------------
# Placeholders only. A real LangSmith personal-access key carries the SaaS's own prefix and must
# never be committed;
# `.env` is in .gitignore and CI reads these from GitHub Actions secrets instead.
TAXCALC_AI_LANGSMITH_API_KEY=replace-me-not-a-real-langsmith-key
TAXCALC_AI_LANGSMITH_PROJECT=taxcalc-ai-dev
TAXCALC_AI_PG_DSN=postgresql://taxcalc:replace-me@localhost:5432/taxcalc
TAXCALC_AI_ANTHROPIC_API_KEY=replace-me-not-a-real-anthropic-key
