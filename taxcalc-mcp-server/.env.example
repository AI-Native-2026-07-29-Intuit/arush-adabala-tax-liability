# taxcalc-mcp-server/.env.example - placeholders only; the real .env is git-ignored.
#
# Every value below reaches the running process through os.environ (pydantic-settings reads it),
# never through a committed file. In the cluster the two secrets arrive from the platform's
# secret store; on a laptop they come from a local .env; under Claude Desktop they come from the
# launcher's "env" block, which a start-up script populates from the OS keychain.

# --- W3 D1 services the tools forward to -----------------------------------------------------
TAXCALC_MCP_ORDERS_SVC_URL=https://taxcalc-orders.internal
TAXCALC_MCP_LLM_PROXY_URL=https://llm-proxy.internal
# This capstone's LLM proxy is the Java service's own LlmProxyController, which serves
# POST /v1/completions. Override only if you point the server at a different proxy.
TAXCALC_MCP_LLM_PROXY_CHAT_PATH=/v1/completions

# --- Credentials (never commit real values) --------------------------------------------------
TAXCALC_MCP_BEARER_JWT=REPLACE_WITH_BEARER_FROM_KEYCHAIN
LANGSMITH_API_KEY=REPLACE_WITH_LANGSMITH_API_KEY
LANGSMITH_PROJECT=taxcalc-mcp-server

# --- Optional: local JWKS validation of the SSE bearer (defence in depth) ---------------------
# Left empty on purpose. The Java services validate the same token authoritatively; a second
# validator pointed at the wrong issuer rejects tokens the real one accepts.
TAXCALC_MCP_JWKS_URL=
TAXCALC_MCP_JWT_AUDIENCE=taxcalc-api

# --- Deadlines and binding -------------------------------------------------------------------
TAXCALC_MCP_TOOL_TIMEOUT_DEFAULT_S=5
TAXCALC_MCP_TOOL_TIMEOUT_RAG_S=30
TAXCALC_MCP_HOST=0.0.0.0
TAXCALC_MCP_PORT=8080
