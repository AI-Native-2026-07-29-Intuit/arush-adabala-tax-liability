{
  "uid": "taxcalc-red-v1",
  "title": "taxcalc-api - RED",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["taxcalc", "red", "week5"],
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "ns", "type": "constant", "current": { "value": "taxcalc-dev" }, "query": "taxcalc-dev", "hide": 2 },
      { "name": "app", "type": "constant", "current": { "value": "taxcalc-api" }, "query": "taxcalc-api", "hide": 2 },
      { "name": "uri", "type": "constant", "current": { "value": "/api/v1/taxpayers/{id}" }, "query": "/api/v1/taxpayers/{id}", "hide": 2 }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate (req/s by status)",
      "description": "R of RED. Grouped by HTTP status rather than by method+uri: on a single-endpoint dashboard the status split is what tells you whether traffic changed or behaviour did.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{app=\"$app\",uri=\"$uri\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors (5xx fraction)",
      "description": "E of RED, as a fraction rather than a count: 20 failures per second means nothing until you know whether that is 0.1% or 100% of traffic.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{app=\"$app\",uri=\"$uri\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{app=\"$app\",uri=\"$uri\"}[5m])), 0.001)",
          "legendFormat": "5xx fraction"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration p50 / p95 / p99",
      "description": "D of RED, computed from the _bucket series that management.metrics.distribution.percentiles-histogram publishes. exemplar: true is what puts the trace-carrying diamonds under the p95/p99 lines.",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{app=\"$app\",uri=\"$uri\"}[5m])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{app=\"$app\",uri=\"$uri\"}[5m])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{app=\"$app\",uri=\"$uri\"}[5m])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "In-flight requests",
      "description": "Concurrency, from Boot's http_server_requests_active gauge. Rising in-flight with flat rate is the signature of requests getting slower rather than more numerous.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(http_server_requests_active_seconds_active_count{app=\"$app\"})",
          "legendFormat": "in-flight"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Business events (taxcalc_liability_recomputed_total)",
      "description": "The one custom metric outside the http_server_requests family, split by outcome. A counter, not a gauge: rate() over it survives pod restarts for free.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (outcome) (rate(taxcalc_liability_recomputed_total{app=\"$app\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
