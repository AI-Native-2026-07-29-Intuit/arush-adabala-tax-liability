# .env - read automatically by `docker compose` for ${VAR} substitution in compose.yaml.
# Distinct from envs/taxcalc.env, which is injected into the taxcalc-api container's
# runtime environment via env_file: and is NOT consulted for Compose-level interpolation.
APP_VERSION=0.1.0

# COMPOSE_FILE is one of the special variables Compose also reads from this file (not
# just app-level ${VAR} substitution). Setting it here makes every bare `docker compose`
# invocation merge in compose.profiles.yaml too - which, unlike compose.override.yaml,
# Compose never auto-discovers on its own - so `--profile test`/`--profile e2e` resolve
# without needing `-f compose.profiles.yaml` spelled out every time. Profile-gated
# services (seed-fixtures, taxcalc-web, otelcol, jaeger) still only start when their
# profile is actually activated, so this has no effect on plain `docker compose up`.
COMPOSE_FILE=compose.yaml:compose.override.yaml:compose.profiles.yaml
