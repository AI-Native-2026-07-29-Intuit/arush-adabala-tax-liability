# taxcalc-agent-svc/.env.example
# Placeholders only. The real .env is git-ignored and never committed; CI injects its values
# from repository secrets. Every name here is read by taxcalc_agent_svc.settings.Settings
# (prefix TAXCALC_AGENT_) except the unprefixed ones below, which belong to the sidecar, to the
# LangSmith SDK, or - in RERANKER's case - to both this service and the sidecar, and are therefore
# spelled the way THOSE consumers read them.

# --- this service ---------------------------------------------------------------------------
TAXCALC_AGENT_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
TAXCALC_AGENT_MCP_SSE_URL=https://mcp.taxcalc.internal/sse
TAXCALC_AGENT_LANGSMITH_PROJECT=taxcalc-agent-svc-dev
TAXCALC_AGENT_ANTHROPIC_API_KEY=sk-ant-...
TAXCALC_AGENT_BEARER_JWT=eyJ...
TAXCALC_AGENT_MODEL=claude-sonnet-4-5

# Per-request cost ceiling in 1e-5 USD minor units. 25000 = $0.25. An integer, never a decimal:
# see src/taxcalc_agent_svc/budgets.py on why money is not a binary fraction here.
TAXCALC_AGENT_COST_CEILING_USD_E5=25000
# Super-step cap, applied to every run config. StateGraph.compile() accepts no recursion limit,
# so a call site is the only place it CAN be pinned - and it is pinned explicitly there so a
# library default that moves cannot move this service's runaway protection with it.
TAXCALC_AGENT_RECURSION_LIMIT=25

# Per-node deadlines in seconds, from the lesson's p99 measurements.
TAXCALC_AGENT_DEADLINE_RETRIEVAL_S=3.0
TAXCALC_AGENT_DEADLINE_API_S=5.0
TAXCALC_AGENT_DEADLINE_SYNTHESIS_S=8.0

# Fraction of production traces the RAGAS sampler scores. 0.01 = 1%.
TAXCALC_AGENT_RAGAS_SAMPLE_RATE=0.01

# --- read by the W7 D3 sidecar, not by this service's Settings ---------------------------------
# Deliberately NOT re-prefixed: taxcalc_ai reads these names, and renaming them here would mean
# this service sets a variable the pipeline never looks at.
TAXCALC_AI_PG_DSN=postgresql://postgres:postgres@localhost:5432/postgres
TAXCALC_AI_REDIS_URL=redis://localhost:6379/0

# --- read by BOTH, which is why it carries neither prefix --------------------------------------
# Which reranker the retrieval stage uses: `bge` (the local cross-encoder, no credential and no
# network) or `cohere` (hosted rerank-3.5, which buys a deadline that genuinely cancels and costs
# a network hop plus per-query billing). This service validates the value at boot and exports it;
# taxcalc_ai.rerank.rerank_candidates dispatches on it. One name on purpose - it used to be
# TAXCALC_AI_RERANKER here and nothing at all there, so selecting cohere changed the environment
# and not the retrieval. TAXCALC_AGENT_RERANKER is still accepted, for deployments already set.
RERANKER=bge
# Required only when RERANKER=cohere. Checked by this service's Settings at boot rather than left
# to fail inside the sidecar on the first question anyone asks.
COHERE_API_KEY=replace-me-when-reranker-is-cohere

# --- read by the LangSmith SDK itself ----------------------------------------------------------
# LANGSMITH_PROJECT (unprefixed) does NOT change where this service's spans land - every span,
# the root chat_request run included, takes its project from TAXCALC_AGENT_LANGSMITH_PROJECT
# above. Setting only the bare one sends spans to one project while you query another, which
# fails silently in the most expensive way.
# This was not true until the root span was given a project of its own: LangSmith files a trace
# under its ROOT run's project and children inherit it, so naming the project on the three node
# decorators and not on the root sent entire traces to LANGSMITH_PROJECT's default regardless of
# what the prefixed variable said.
# NOTE: the placeholder deliberately does NOT spell LangSmith's real key prefix. Both this
# repository's secret-scan gates grep the whole tree for that literal, and a placeholder
# containing it fails them - correctly, since a scanner that had to special-case "but not in
# .env.example" is a scanner with a hole in it. Paste the real key here in your local .env,
# which is git-ignored.
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_TRACING=true
