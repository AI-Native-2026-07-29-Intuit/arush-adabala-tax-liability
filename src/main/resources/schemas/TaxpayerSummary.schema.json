{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaxpayerSummary",
  "type": "object",
  "properties": {
    "filingStatus": {
      "type": "string",
      "enum": ["SINGLE", "MARRIED_FILING_JOINTLY", "MARRIED_FILING_SEPARATELY", "HEAD_OF_HOUSEHOLD"]
    },
    "totalLiability": {
      "type": "number",
      "minimum": 0
    },
    "jurisdictionCount": {
      "type": "integer",
      "minimum": 0
    },
    "riskBand": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    }
  },
  "required": ["filingStatus", "totalLiability", "jurisdictionCount", "riskBand"],
  "additionalProperties": false
}
