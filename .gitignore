.gradle/
build/
out/
.idea/
.vscode/
*.iml

# Machine-local Claude Code permission grants. The skill under
# .claude/skills/ IS committed (it is the W6 D2 argocd-author deliverable);
# this file is not - it authorises actions on THIS machine only, and
# committing it would hand those grants to everyone who clones the repo.
.claude/settings.local.json

# Compose-managed dev state (W5 D2). NEVER commit any of these.
envs/*.env
!envs/*.env.example
secrets/*
!secrets/.gitkeep
compose-logs.txt

# SAM build state (W5 D4). NEVER commit any of these.
# (`/tmp/sam-smoke-body` is kept verbatim from the deliverable's appendix. Note a leading slash
#  anchors to the repo root, so it matches <repo>/tmp/... rather than the real /tmp - and
#  sam-smoke.sh uses mktemp now anyway, so it matches nothing. Harmless, left for parity.)
.aws-sam/
samconfig.toml
events/*.local.json
/tmp/sam-smoke-body
target/

# Kubernetes-managed dev state (W5 D3). NEVER commit any of these.
manifests/*.local.yaml
pod-logs.txt
k8s-diagnostics/
.k3d/

# Observability artefacts the build / CI tooling produces (W5 D5).
# The authoritative dashboard is .grafana/dashboards/*.json in git; anything Grafana or Sloth
# regenerates locally is output, not source, and committing it creates a second copy that
# drifts from the one CI checks.
.grafana/exported/
sloth-out/
/tmp/observability-smoke-*
obs-diagnostics.txt

# Python bytecode (e.g. from py_compile checks on scripts/)
__pycache__/
*.pyc

# W6 D5: load-test key material and minted tokens. The private key never leaves the machine
# that generated it; the tokens are short-lived. Both are regenerated by scripts/loadtest-token.sh.
.loadtest/

# W7 D5: the agent-svc project. `.env` carries an Anthropic key, a LangSmith key and a bearer
# JWT; .env.example is the committed placeholder copy. The venv and the eval's scratch output are
# build artefacts - evals/last_run.json is NOT here, because that file is the committed
# cost-per-run baseline the CI gate compares against and must be in git to be a baseline at all.
.env
taxcalc-agent-svc/.venv/
taxcalc-agent-svc/.coverage

# PR bodies are scratch: the PR itself is the durable copy, and they quote failure messages
# verbatim - including, once, the very key prefix the secret-scan gates grep for, which is how a
# committed one turned two CI tiers red. Same convention as taxcalc-mcp-server/PR_BODY.md.
*/PR_BODY.md
