.gradle/
build/
out/
.idea/
.vscode/
*.iml

# Compose-managed dev state (W5 D2). NEVER commit any of these.
envs/*.env
!envs/*.env.example
secrets/*
!secrets/.gitkeep
compose-logs.txt

# SAM build state (W5 D4). NEVER commit any of these.
# (`/tmp/sam-smoke-body` is kept verbatim from the deliverable's appendix. Note a leading slash
#  anchors to the repo root, so it matches <repo>/tmp/... rather than the real /tmp - and
#  sam-smoke.sh uses mktemp now anyway, so it matches nothing. Harmless, left for parity.)
.aws-sam/
samconfig.toml
events/*.local.json
/tmp/sam-smoke-body
target/

# Kubernetes-managed dev state (W5 D3). NEVER commit any of these.
manifests/*.local.yaml
pod-logs.txt
k8s-diagnostics/
.k3d/

# Observability artefacts the build / CI tooling produces (W5 D5).
# The authoritative dashboard is .grafana/dashboards/*.json in git; anything Grafana or Sloth
# regenerates locally is output, not source, and committing it creates a second copy that
# drifts from the one CI checks.
.grafana/exported/
sloth-out/
/tmp/observability-smoke-*
obs-diagnostics.txt

# Python bytecode (e.g. from py_compile checks on scripts/)
__pycache__/
*.pyc
